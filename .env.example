# Optional: local development works without a .env file.
# Vite and CLI tools read ROOT .env; shell variables take precedence.
# VITE_ values are public. Never put credentials in them.

# Browser defaults: first manifest entry, manifest RPC, ipfs.io gateway.
# VITE_DEFAULT_DEPLOYMENT=your-dev-v1
# VITE_RPC_URL=https://your-public-rpc.example
# VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
# Optional Kubo endpoint; can also be entered directly in Reports.
# VITE_IPFS_API_URL=https://your-ipfs.example
# Docker app uses public build arguments in compose.yaml, not this .env file.
# For host Vite with Docker services, npm run dev:docker sets these automatically:
# VITE_IPFS_API_URL=http://127.0.0.1:5001
# VITE_IPFS_GATEWAY=http://127.0.0.1:8080/ipfs/

# Remote development only. Set actual values before deploying/importing.
# CLI RPC may be private; BROWSER_RPC_URL is deliberately exported to the app.
DEV_RPC_URL=
DEV_CHAIN_ID=
DEV_TESTNET=
BROWSER_RPC_URL=
PROTOCOL_VERSION=
# New deployment: issuer wallet. Registration: actual deployed OpenFund address.
OFL_ISSUER=
OPENFUND_ADDRESS=
# Import: actual OpenFund contract-creation transaction hash.
OPENFUND_DEPLOYMENT_TX=
# Optional network metadata (defaults: Ether / ETH, 18 decimals, no explorer).
# DEV_NATIVE_NAME=Ether
# DEV_NATIVE_SYMBOL=ETH
# DEV_EXPLORER_URL=https://your-explorer.example

# Optional Pinata CLI credential; choose Pinata in Reports to use a signed URL.
# PINATA_JWT=
# Optional local RPC (Anvil chain 31337); default http://127.0.0.1:8545.
# LOCAL_RPC_URL=http://127.0.0.1:8545
# Optional local explorer, exported in the deployment manifest when deploying.
# LOCAL_EXPLORER_URL=http://127.0.0.1:4000
# Explicit consent to replace the local manifest after an Anvil reset.
# REPLACE_LOCAL_DEPLOYMENT=1
