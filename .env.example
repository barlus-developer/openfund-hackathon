# Public browser configuration only. No secret may use a VITE_ prefix.
# Copy this file to ROOT .env (Vite and npm development CLI helpers both read it).
# After importing a remote deployment, change this to its exact PROTOCOL_VERSION.
VITE_DEFAULT_DEPLOYMENT=local-v1
# Optional browser-safe override for the selected deployment's chain. Blank uses its manifest.
VITE_RPC_URL=
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
# Real uploads: kubo (your HTTPS IPFS endpoint) or pinata (temporary signed URL in Reports).
VITE_IPFS_PROVIDER=kubo
VITE_IPFS_API_URL=

# Remote development CLI / verified manifest import (fill with your actual network).
# DEV_RPC_URL may be private; BROWSER_RPC_URL is intentionally public in the static app.
DEV_RPC_URL=
BROWSER_RPC_URL=
DEV_CHAIN_ID=
DEV_TESTNET=1
DEV_CONFIRMATIONS=2
DEPLOYMENT_NAME=
PROTOCOL_VERSION=
DEV_EXPLORER_URL=
DEV_NATIVE_NAME=Ether
DEV_NATIVE_SYMBOL=ETH
# Addresses and transaction hashes from actual deployment/registration, never guessed:
OFL_ISSUER=
OPENFUND_ADDRESS=
OPENFUND_DEPLOYMENT_TX=
# Optional Pinata CLI-only credential. Never rename this to VITE_PINATA_JWT.
# PINATA_JWT=

# CLI local scripts only:
LOCAL_RPC_URL=http://127.0.0.1:8545
# Deliberate local manifest replacement after a fresh Anvil reset:
# REPLACE_LOCAL_DEPLOYMENT=1
# Public protocol deployment: use Foundry --account <keystore> / hardware wallet.
