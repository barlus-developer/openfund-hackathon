{
  "name": "openfund-laos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w app --",
    "build": "npm run build -w app",
    "typecheck": "npm run typecheck -w app",
    "test": "npm run test -w app",
    "contracts:build": "node scripts/foundry.mjs forge build --root contracts",
    "contracts:test": "node scripts/foundry.mjs forge test --root contracts",
    "local": "bash scripts/local-start.sh",
    "deploy:local": "bash scripts/local-deploy.sh",
    "deploy:dev": "node scripts/dev-protocol.mjs",
    "register:dev": "node scripts/dev-protocol.mjs register",
    "deployment:import": "node scripts/import-deployment.mjs",
    "ipfs:sign": "node scripts/ipfs-sign.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "seed:local": "node scripts/local-seed.mjs",
    "abi": "node scripts/sync-abis.mjs",
    "lint": "npm run lint -w app",
    "format": "prettier --write app/src app/tests scripts docs README.md",
    "contracts:fmt": "node scripts/foundry.mjs forge fmt --root contracts",
    "e2e": "playwright test",
    "local:verify": "node scripts/local-verify.mjs",
    "docs:contracts": "node scripts/contract-docs.mjs",
    "security": "node scripts/security-check.mjs"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "^1.7.1",
    "@foundry-rs/cast": "^1.7.1",
    "@foundry-rs/forge": "^1.7.1",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "viem": "^2.57.7"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
